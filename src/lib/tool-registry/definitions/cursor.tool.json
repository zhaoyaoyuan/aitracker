{
  "$schema": "../tool-definition.schema.json",
  "configVersion": 1,
  "id": "cursor",
  "display": {
    "name": "Cursor",
    "nameZh": "Cursor",
    "icon": "cursor",
    "color": "#cfcfcf"
  },
  "platforms": {
    "macos": "supported",
    "windows": "supported",
    "linux": "planned"
  },
  "detection": {
    "locations": [
      {
        "targets": ["macos"],
        "base": "appData",
        "path": "Cursor"
      },
      {
        "targets": ["macos", "windows10", "windows11", "linux"],
        "base": "home",
        "path": ".cursor"
      },
      {
        "targets": ["macos", "linux"],
        "base": "configHome",
        "path": "tokscale/cursor-cache"
      },
      {
        "targets": ["windows10", "windows11"],
        "base": "appDataRoaming",
        "path": "Cursor"
      }
    ],
    "executable": {
      "shared": ["cursor"]
    }
  },
  "storage": {
    "dataRoots": [
      {
        "base": "appData",
        "path": "Cursor"
      },
      {
        "base": "appDataRoaming",
        "path": "Cursor"
      }
    ],
    "skills": {
      "rootSpecs": [
        {
          "base": "home",
          "path": ".cursor/skills"
        }
      ],
      "markers": ["SKILL.md", "skill.md"],
      "maxDepth": 3
    }
  },
  "capabilities": {
    "usage": {
      "mode": "native",
      "reader": "cursor-transcript-v1",
      "maxFileSizeBytes": 67108864,
      "paths": [
        {
          "targets": ["macos", "windows10", "windows11", "linux"],
          "base": "home",
          "path": ".cursor/projects",
          "glob": "*/agent-transcripts/*/*.jsonl",
          "format": "jsonl"
        }
      ]
    },
    "skills": "read-write",
    "agents": "unsupported",
    "sessions": {
      "mode": "read",
      "reader": "cursor-session-v1"
    },
    "market": "install-target",
    "security": "unsupported"
  },
  "modelObservation": {
    "modelField": "model"
  }
}
